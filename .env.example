# Support form (/api/support). Set these in Vercel > Project > Settings > Environment Variables.
# Never commit real values. Each channel turns on only when its variables are set.

# GitHub issue on the app repo. Fine-grained token: Repository access = only thianhlu/breath,
# Permissions = Issues: Read and write (Metadata: Read is added automatically).
SUPPORT_GITHUB_TOKEN=
# SUPPORT_GITHUB_REPO=thianhlu/breath

# Email notification over SMTP (free with a Gmail account + Google App Password).
SMTP_USER=
SMTP_PASS=
SUPPORT_EMAIL_TO=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SUPPORT_EMAIL_FROM=
