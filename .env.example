# Support form (/api/support). Set these in Vercel > Project > Settings > Environment Variables.
# Never commit real values. Mark them Sensitive in Vercel.

# AgentMail API key (Bearer) and the inbox the form sends from, e.g. hellobirch@agentmail.to.
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=
# Where support messages are delivered. Reply-to is set to the person who filled in the form.
SUPPORT_EMAIL_TO=
